{
  "name": "fresh-import-sessions",
  "capture": {
    "geometry": "144x46",
    "font": "JetBrains Mono 17",
    "screen": "2600x1600x24",
    "display": ":99",
    "settle": 10,
    "term": "xfce4-terminal",
    "workdir": "$DEMO_HOME/src/payments-api",
    "key_settle": 0.25,
    "type_settle": 0.5,
    "copy_dirs": {
      "$CLIP_ASSETS/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "HOME": "$DEMO_HOME",
      "TMUX_TMPDIR": "$DEMO_HOME/.tmux",
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_CACHE_HOME": "{scratch}/cache-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "panes": {
      "import": {
        "argv": [
          "$FRESH_BIN",
          "--no-upgrade-check",
          "--no-restore",
          "$DEMO_HOME/src/payments-api",
          "$DEMO_HOME/src/payments-api/app/webhooks.py"
        ]
      }
    },
    "keys": [
      {
        "sleep": 1.0
      },
      {
        "shot": "start"
      },
      {
        "record": "open",
        "seconds": 4.0
      },
      {
        "sleep": 0.7
      },
      {
        "click": {
          "col": 16,
          "row": 0
        },
        "settle": 1.3
      },
      {
        "click": {
          "col": 9,
          "row": 7
        },
        "settle": 0.4
      },
      {
        "sleep": 1.6
      },
      {
        "shot": "dialog"
      },
      {
        "record": "scan",
        "seconds": 4.0
      },
      {
        "sleep": 0.6
      },
      {
        "key": "Return"
      },
      {
        "sleep": 3.4
      },
      {
        "sleep": 1.0
      },
      {
        "shot": "scanned"
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e1"
      },
      {
        "key": "Down",
        "repeat": 5
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e2"
      },
      {
        "key": "Down",
        "repeat": 5
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e3"
      },
      {
        "key": "Down",
        "repeat": 2
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "all"
      },
      {
        "key": "shift+Tab"
      },
      {
        "key": "shift+Tab",
        "settle": 0.4
      },
      {
        "type": "i"
      },
      {
        "shot": "f1"
      },
      {
        "type": "d"
      },
      {
        "shot": "f2"
      },
      {
        "type": "e"
      },
      {
        "shot": "f3"
      },
      {
        "type": "m"
      },
      {
        "shot": "f4"
      },
      {
        "key": "Return",
        "settle": 1.5
      },
      {
        "shot": "form"
      },
      {
        "record": "launch",
        "seconds": 5.5
      },
      {
        "sleep": 0.8
      },
      {
        "click": {
          "col": 107,
          "row": 36
        }
      },
      {
        "sleep": 9.6
      },
      {
        "shot": "resumed"
      }
    ]
  },
