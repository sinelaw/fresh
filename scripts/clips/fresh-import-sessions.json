{
  "name": "fresh-import-sessions",
  "capture": {
    "geometry": "144x34",
    "font": "JetBrains Mono 17",
    "screen": "2600x1600x24",
    "display": ":99",
    "settle": 10,
    "term": "xfce4-terminal",
    "workdir": "$DEMO_HOME/src/payments-api",
    "key_settle": 0.25,
    "type_settle": 0.5,
    "copy_dirs": {
      "$CLIP_ASSETS/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "HOME": "$DEMO_HOME",
      "TMUX_TMPDIR": "$DEMO_HOME/.tmux",
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_CACHE_HOME": "{scratch}/cache-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "panes": {
      "import": {
        "argv": [
          "$FRESH_BIN",
          "--no-upgrade-check",
          "--no-restore",
          "$DEMO_HOME/src/payments-api",
          "$DEMO_HOME/src/payments-api/app/webhooks.py"
        ]
      }
    },
    "keys": [
      {
        "sleep": 1.0
      },
      {
        "click": {
          "col": 16,
          "row": 0
        },
        "settle": 1.0
      },
      {
        "click": {
          "col": 9,
          "row": 7
        },
        "settle": 1.2
      },
      {
        "shot": "dialog"
      },
      {
        "record": "scan",
        "seconds": 3.6
      },
      {
        "sleep": 0.5
      },
      {
        "click": {
          "col": 81,
          "row": 6
        }
      },
      {
        "sleep": 3.0
      },
      {
        "sleep": 1.5
      },
      {
        "shot": "scanned"
      },
      {
        "record": "pick",
        "seconds": 2.2
      },
      {
        "sleep": 0.5
      },
      {
        "click": {
          "col": 30,
          "row": 10
        },
        "settle": 0.7
      },
      {
        "move": {
          "col": 110,
          "row": 14
        }
      },
      {
        "sleep": 1.3
      },
      {
        "click": {
          "col": 110,
          "row": 14
        },
        "settle": 0.1
      },
      {
        "sleep": 1.4
      },
      {
        "shot": "form"
      },
      {
        "click": {
          "col": 107,
          "row": 30
        }
      },
      {
        "sleep": 9.0
      },
      {
        "shot": "done"
      }
    ]
  },
  "render": {
    "size": [
      1920,
      1080
    ],
    "fps": 60,
    "rows": 34,
    "cols": 144,
    "title": "fresh — import sessions",
    "note_size": 46,
    "labels": {
      "solo": ""
    },
    "views": {
      "scan": {
        "rows": [
          3,
          17
        ],
        "cols": [
          17,
          126
        ]
      },
      "list": {
        "rows": [
          9,
          25
        ],
        "cols": [
          17,
          126
        ]
      },
      "dock": {
        "rows": [
          0,
          14
        ],
        "cols": [
          0,
          96
        ]
      }
    },
    "timing": {
      "intro": 0,
      "zoom": 0,
      "hold": 2.0,
      "pan": 0.7,
      "push": 0.6,
      "wipe": 0.5,
      "outro": 0.4
    },
    "annotations": [
      {
        "shots": "scan",
        "view": "scan",
        "rows": [
          6,
          7
        ],
        "cols": [
          76,
          88
        ],
        "band": false,
        "hold": 2.4,
        "tag": {
          "text": "Import sessions: scan this machine",
          "at": "bottom-center",
          "width": 0.7,
          "size": 48,
          "color": "after",
          "bg": true
        }
      },
      {
        "shots": "pick",
        "view": "list",
        "rows": [
          10,
          15
        ],
        "cols": [
          21,
          121
        ],
        "band": false,
        "hold": 2.6,
        "tag": {
          "text": "pick a Claude Code session",
          "at": "bottom-center",
          "width": 0.7,
          "size": 48,
          "color": "after",
          "bg": true
        }
      },
      {
        "shot": "done",
        "view": "dock",
        "rows": [
          4,
          5
        ],
        "cols": [
          0,
          38
        ],
        "hold": 3.0,
        "transition": "wipe",
        "note": "resumed in the dock",
        "note_at": "below-right"
      }
    ]
  },
  "encode": {
    "crf": 18,
    "preset": "slow"
  }
}
