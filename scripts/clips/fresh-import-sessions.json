{
  "name": "fresh-import-sessions",
  "capture": {
    "geometry": "144x46",
    "font": "JetBrains Mono 17",
    "screen": "2600x1600x24",
    "display": ":99",
    "settle": 10,
    "term": "xfce4-terminal",
    "workdir": "$DEMO_HOME/src/payments-api",
    "key_settle": 0.25,
    "type_settle": 0.5,
    "copy_dirs": {
      "$CLIP_ASSETS/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "HOME": "$DEMO_HOME",
      "TMUX_TMPDIR": "$DEMO_HOME/.tmux",
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_CACHE_HOME": "{scratch}/cache-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "panes": {
      "import": {
        "argv": [
          "$FRESH_BIN",
          "--no-upgrade-check",
          "--no-restore",
          "$DEMO_HOME/src/payments-api",
          "$DEMO_HOME/src/payments-api/app/webhooks.py"
        ]
      }
    },
    "keys": [
      {
        "sleep": 1.0
      },
      {
        "shot": "start"
      },
      {
        "record": "open",
        "seconds": 4.0
      },
      {
        "sleep": 0.7
      },
      {
        "click": {
          "col": 16,
          "row": 0
        },
        "settle": 1.3
      },
      {
        "click": {
          "col": 9,
          "row": 7
        },
        "settle": 0.4
      },
      {
        "sleep": 1.6
      },
      {
        "shot": "dialog"
      },
      {
        "sleep": 0.6
      },
      {
        "key": "Return"
      },
      {
        "sleep": 3.4
      },
      {
        "sleep": 1.0
      },
      {
        "shot": "scanned"
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e1"
      },
      {
        "key": "Down",
        "repeat": 5
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e2"
      },
      {
        "key": "Down",
        "repeat": 5
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "e3"
      },
      {
        "key": "Down",
        "repeat": 2
      },
      {
        "key": "Return",
        "settle": 0.5
      },
      {
        "shot": "all"
      },
      {
        "key": "shift+Tab"
      },
      {
        "key": "shift+Tab",
        "settle": 0.4
      },
      {
        "type": "i"
      },
      {
        "shot": "f1"
      },
      {
        "type": "d"
      },
      {
        "shot": "f2"
      },
      {
        "type": "e"
      },
      {
        "shot": "f3"
      },
      {
        "type": "m"
      },
      {
        "shot": "f4"
      },
      {
        "key": "Return",
        "settle": 1.5
      },
      {
        "shot": "form"
      },
      {
        "sleep": 0.8
      },
      {
        "click": {
          "col": 107,
          "row": 36
        }
      },
      {
        "sleep": 9.6
      },
      {
        "shot": "resumed"
      }
    ]
  },
  "render": {
    "size": [
      1920,
      1080
    ],
    "fps": 60,
    "rows": 46,
    "cols": 144,
    "title": "fresh — import sessions",
    "note_size": 52,
    "labels": {
      "solo": ""
    },
    "views": {
      "menu": {
        "rows": [
          0,
          10
        ],
        "cols": [
          0,
          40
        ]
      },
      "list": {
        "rows": [
          10,
          23
        ],
        "cols": [
          23,
          90
        ]
      },
      "find": {
        "rows": [
          6,
          13
        ],
        "cols": [
          23,
          90
        ]
      },
      "cmd": {
        "rows": [
          12,
          16
        ],
        "cols": [
          18,
          92
        ]
      },
      "convo": {
        "rows": [
          3,
          16
        ],
        "cols": [
          39,
          112
        ]
      },
      "dock": {
        "rows": [
          2,
          7
        ],
        "cols": [
          0,
          40
        ]
      }
    },
    "timing": {
      "intro": 0,
      "zoom": 0,
      "hold": 1.0,
      "pan": 0.18,
      "push": 0.25,
      "wipe": 0.22,
      "outro": 0.25
    },
    "annotations": [
      {
        "shots": "open",
        "view": "menu",
        "rows": [
          0,
          10
        ],
        "cols": [
          0,
          40
        ],
        "band": false,
        "hold": 1.5,
        "tag": {
          "text": "Menu > Import sessions",
          "at": "bottom-right",
          "width": 0.5,
          "size": 60,
          "color": "after",
          "bg": true
        }
      },
      {
        "shots": [
          "scanned",
          "e1",
          "e2",
          "e3",
          "all"
        ],
        "view": "list",
        "rows": [
          10,
          23
        ],
        "cols": [
          23,
          90
        ],
        "band": false,
        "hold": 1.4,
        "transition": "wipe",
        "tag": {
          "text": "every agent session, by repo",
          "at": "bottom-center",
          "width": 0.7,
          "size": 60,
          "color": "after",
          "bg": true
        }
      },
      {
        "shot": "all",
        "view": "list",
        "rows": [
          13,
          20
        ],
        "cols": [
          23,
          90
        ],
        "hold": 1.2,
        "note": "Claude Code + live tmux",
        "note_at": "below-right"
      },
      {
        "shots": [
          "f1",
          "f2",
          "f3",
          "f4"
        ],
        "view": "find",
        "rows": [
          6,
          13
        ],
        "cols": [
          23,
          90
        ],
        "band": false,
        "hold": 1.0,
        "tag": {
          "text": "find it",
          "at": "bottom-center",
          "width": 0.7,
          "size": 60,
          "color": "after",
          "bg": true
        }
      },
      {
        "shot": "form",
        "view": "cmd",
        "rows": [
          14,
          15
        ],
        "cols": [
          18,
          92
        ],
        "hold": 1.3,
        "transition": "wipe",
        "note": "resume, filled in",
        "note_at": "below-right"
      },
      {
        "shot": "resumed",
        "view": "convo",
        "rows": [
          3,
          16
        ],
        "cols": [
          39,
          112
        ],
        "band": false,
        "hold": 1.6,
        "transition": "wipe",
        "tag": {
          "text": "right where it left off",
          "at": "bottom-center",
          "width": 0.7,
          "size": 60,
          "color": "after",
          "bg": true
        }
      },
      {
        "shot": "resumed",
        "view": "dock",
        "rows": [
          4,
          5
        ],
        "cols": [
          0,
          39
        ],
        "hold": 0.85,
        "note": "new workspace",
        "note_at": "below-right"
      }
    ]
  },
  "encode": {
    "crf": 18,
    "preset": "slow"
  }
}
