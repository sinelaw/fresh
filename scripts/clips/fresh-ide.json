{
  "name": "fresh-ide",
  "capture": {
    "geometry": "153x18",
    "font": "DejaVu Sans Mono 15",
    "screen": "2200x700x24",
    "display": ":99",
    "settle": 18,
    "workdir": "~/.cache/fresh-clips/ide-demo",
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-ide/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "keys": [
      {
        "sleep": 3
      },
      {
        "key": "F3"
      },
      {
        "sleep": 1.5
      },
      {
        "key": "t"
      },
      {
        "sleep": 1
      },
      {
        "key": "Return"
      },
      {
        "sleep": 2.5
      },
      {
        "key": "F5"
      },
      {
        "sleep": 2.5
      },
      {
        "type": "XDG_DATA_HOME=\"$HOME/.local/share\" claude"
      },
      {
        "key": "Return"
      },
      {
        "sleep": 8
      },
      {
        "key": "Down"
      },
      {
        "sleep": 0.5
      },
      {
        "key": "Return"
      },
      {
        "sleep": 7
      },
      {
        "key": "F7"
      },
      {
        "sleep": 1.5
      },
      {
        "record": "ide",
        "seconds": 18,
        "fps": 30
      },
      {
        "sleep": 1.5
      },
      {
        "key": "F6"
      },
      {
        "sleep": 1
      },
      {
        "type": "explain what Bucket::take does, in two sentences"
      },
      {
        "key": "Return"
      },
      {
        "sleep": 4
      },
      {
        "key": "F7"
      },
      {
        "sleep": 1
      },
      {
        "key": "Down",
        "repeat": 10
      },
      {
        "sleep": 1.5
      },
      {
        "key": "F6"
      },
      {
        "sleep": 5
      }
    ],
    "panes": {
      "ide": {
        "argv": [
          "~/repos/fresh/target/debug/fresh",
          "--no-restore",
          "--no-upgrade-check",
          "src/main.rs"
        ]
      }
    },
    "unset_env": [
      "CLAUDE_*",
      "CLAUDECODE"
    ]
  },
  "render": {
    "size": [
      1920,
      1080
    ],
    "fps": 60,
    "rows": 18,
    "cols": 153,
    "title": "Microsoft Word - FRESH.DOC",
    "chrome": {
      "style": "word6",
      "assets": "~/Documents/fresh-clip-assets",
      "scale": 3,
      "layout": "side",
      "headline_width": 0.3,
      "header_block": 116,
      "body_size": 22,
      "body_lead": 27,
      "body_lines": 4,
      "embed_title": "MS-DOS Prompt - fresh"
    },
    "timing": {
      "intro": 0,
      "zoom": 0,
      "hold": 18,
      "pan": 0,
      "outro": 0
    },
    "annotations": [
      {
        "shots": "ide",
        "hold": 18,
        "typewriter": 0.45,
        "misspell": [
          "multi-cursor"
        ],
        "head": [
          "Fresh",
          "IDE"
        ],
        "sub": [
          "Fresh is an open-source terminal IDE for",
          "the modern era: zero config, mouse, LSP,",
          "multi-cursor, a command palette \u2014 and",
          "coding agents running beside your code."
        ]
      }
    ]
  },
  "encode": {
    "crf": 18,
    "preset": "slow"
  }
}
