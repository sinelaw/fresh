{
  "theme": "builtin://word6",
  "check_for_updates": false,
  "editor": {
    "animations": true
  },
  "file_explorer": {
    "width": "0"
  },
  "keybindings": [
    {
      "keys": [
        {
          "key": "F3",
          "modifiers": []
        }
      ],
      "action": "workspace_trust_prompt",
      "when": "global"
    },
    {
      "keys": [
        {
          "key": "F5",
          "modifiers": []
        }
      ],
      "action": "open_terminal_right",
      "when": "global"
    },
    {
      "keys": [
        {
          "key": "F6",
          "modifiers": []
        }
      ],
      "action": "focus_terminal",
      "when": "global"
    },
    {
      "keys": [
        {
          "key": "F7",
          "modifiers": []
        }
      ],
      "action": "focus_editor",
      "when": "global"
    }
  ],
  "plugins": {
    "dashboard": {
      "enabled": false
    },
    "git_heatmap": {
      "enabled": false
    },
    "markdown_compose": {
      "enabled": false
    },
    "vi_mode": {
      "enabled": false
    }
  }
}
