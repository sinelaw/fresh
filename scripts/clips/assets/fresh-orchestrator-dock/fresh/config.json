{
  "theme": "builtin://dracula",
  "check_for_updates": false,
  "editor": {
    "animations": true,
    "cursor_jump_animation": true
  },
  "keybindings": [
    {
      "keys": [
        {
          "key": "F8",
          "modifiers": []
        }
      ],
      "action": "toggle_dock_focus",
      "when": "normal"
    },
    {
      "keys": [
        {
          "key": "F7",
          "modifiers": []
        }
      ],
      "action": "toggle_maximize_split",
      "when": "normal"
    },
    {
      "keys": [
        {
          "key": "F6",
          "modifiers": []
        }
      ],
      "action": "next_split",
      "when": "normal"
    }
  ],
  "plugins": {
    "orchestrator": {
      "enabled": true,
      "settings": {
        "autoOpenDock": true,
        "defaultView": "compact"
      }
    },
    "welcome_screen": {
      "enabled": false
    },
    "dashboard": {
      "enabled": false
    },
    "git_heatmap": {
      "enabled": false
    },
    "vi_mode": {
      "enabled": false
    }
  }
}