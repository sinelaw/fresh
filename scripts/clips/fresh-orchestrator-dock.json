{
  "name": "fresh-orchestrator-dock",
  "capture": {
    "geometry": "140x29",
    "font": "JetBrains Mono 16",
    "screen": "2000x1000x24",
    "display": ":99",
    "workdir": "~/repos/fresh/target/clips/fresh-orchestrator-dock/api",
    "settle": 55,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-orchestrator-dock/fresh": "{scratch}/config/fresh",
      "~/repos/fresh/scripts/clips/assets/fresh-orchestrator-dock/bin": "{scratch}/bin"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}",
      "PATH": "{scratch}/bin:$PATH",
      "LANG": "C.UTF-8",
      "LC_ALL": "C.UTF-8",
      "FRESH_CLIP_AGENT": "~/repos/fresh/crates/fresh-editor/tests/fixtures/coding_agent.py"
    },
    "keys": [
      {
        "drag": {
          "from_col": 38,
          "to_col": 24,
          "row": 12
        }
      },
      {
        "sleep": 0.5
      },
      {
        "sleep": 1.5
      },
      {
        "record": "a",
        "seconds": 2.2,
        "fps": 30
      },
      {
        "sleep": 2.4
      },
      {
        "record": "b",
        "seconds": 1.6,
        "fps": 30
      },
      {
        "sleep": 0.4
      },
      {
        "key": "Up"
      },
      {
        "sleep": 1.3
      },
      {
        "record": "c",
        "seconds": 1.8,
        "fps": 30
      },
      {
        "sleep": 2.0
      },
      {
        "record": "d",
        "seconds": 1.6,
        "fps": 30
      },
      {
        "sleep": 0.4
      },
      {
        "key": "Up"
      },
      {
        "sleep": 1.3
      },
      {
        "record": "e",
        "seconds": 2.0,
        "fps": 30
      },
      {
        "sleep": 2.2
      }
    ],
    "panes": {
      "dock": {
        "argv": [
          "~/repos/fresh/target/release/fresh",
          "--no-restore",
          "--no-upgrade-check"
        ]
      }
    }
  },
  "render": {
    "size": [
      1822,
      940
    ],
    "fps": 60,
    "rows": 29,
    "cols": 140,
    "header_height": 96,
    "caption_height": 118,
    "title": "fresh \u00b7 orchestrator",
    "labels": {
      "solo": "NEW"
    },
    "intro_caption": [
      "The Orchestrator dock",
      "a worktree per task, an agent per worktree"
    ],
    "outro_caption": [
      "fresh",
      "github.com/sinelaw/fresh"
    ],
    "timing": {
      "title": 1.6,
      "intro": 0.7,
      "zoom": 0.45,
      "hold": 1.3,
      "pan": 0.3,
      "outro": 0.6
    },
    "theme": {
      "bg": [
        18,
        19,
        26
      ],
      "caption_bg": [
        28,
        29,
        40
      ],
      "panel_border": [
        68,
        71,
        90
      ],
      "muted": [
        150,
        157,
        192
      ],
      "fg": [
        248,
        248,
        242
      ],
      "after": [
        80,
        250,
        123
      ]
    },
    "annotations": [
      {
        "shots": "a",
        "hold": 2.2,
        "rows": [
          4,
          16
        ],
        "cols": [
          27,
          110
        ],
        "note": "agent is running",
        "note_at": "below-right"
      },
      {
        "shots": "b",
        "hold": 1.6,
        "rows": [
          0,
          29
        ],
        "band": false
      },
      {
        "shots": "c",
        "hold": 1.8,
        "rows": [
          4,
          10
        ],
        "cols": [
          0,
          25
        ],
        "note": "switch between sessions",
        "note_at": "below-right"
      },
      {
        "shots": "d",
        "hold": 1.6,
        "rows": [
          0,
          29
        ],
        "band": false
      },
      {
        "shots": "e",
        "hold": 2.0,
        "rows": [
          3,
          15
        ],
        "cols": [
          84,
          139
        ],
        "note": "diff and full IDE",
        "note_at": "below-left"
      }
    ],
    "title_card": {
      "lines": [
        {
          "text": "mission control",
          "effect": "shine",
          "at": 0.03
        },
        {
          "text": "one editor, every worktree",
          "small": true,
          "at": 0.4
        }
      ]
    },
    "vignette": {
      "edge": 0.012,
      "side": 0.0
    },
    "note_size": 34
  },
  "encode": {
    "crf": 18,
    "preset": "slow"
  }
}