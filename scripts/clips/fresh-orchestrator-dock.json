{
  "name": "fresh-orchestrator-dock",
  "capture": {
    "geometry": "140x29",
    "font": "JetBrains Mono 16",
    "screen": "2000x1000x24",
    "display": ":99",
    "workdir": "~/repos/fresh/target/clips/fresh-orchestrator-dock/api",
    "settle": 55,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-orchestrator-dock/fresh": "{scratch}/config/fresh",
      "~/repos/fresh/scripts/clips/assets/fresh-orchestrator-dock/bin": "{scratch}/bin"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}",
      "PATH": "{scratch}/bin:$PATH",
      "LANG": "C.UTF-8",
      "LC_ALL": "C.UTF-8",
      "FRESH_CLIP_AGENT": "~/repos/fresh/crates/fresh-editor/tests/fixtures/coding_agent.py"
    },
    "keys": [
      {
        "key": "F8"
      },
      {
        "sleep": 2
      },
      {
        "record": "a",
        "seconds": 1.0,
        "fps": 30
      },
      {
        "sleep": 1.2
      },
      {
        "record": "b",
        "seconds": 2.2,
        "fps": 30
      },
      {
        "sleep": 0.5
      },
      {
        "key": "Down"
      },
      {
        "sleep": 1.8000000000000003
      },
      {
        "record": "c",
        "seconds": 1.8,
        "fps": 30
      },
      {
        "sleep": 0.5
      },
      {
        "key": "Down"
      },
      {
        "sleep": 1.4
      },
      {
        "record": "d",
        "seconds": 2.0,
        "fps": 30
      },
      {
        "sleep": 0.5
      },
      {
        "key": "Down"
      },
      {
        "sleep": 1.6
      },
      {
        "record": "e",
        "seconds": 2.6,
        "fps": 30
      },
      {
        "sleep": 0.5
      },
      {
        "key": "Down"
      },
      {
        "sleep": 2.2
      }
    ],
    "panes": {
      "dock": {
        "argv": [
          "~/repos/fresh/target/release/fresh",
          "--no-restore",
          "--no-upgrade-check"
        ]
      }
    }
  },
  "render": {
    "size": [
      1822,
      1058
    ],
    "fps": 60,
    "rows": 29,
    "cols": 140,
    "header_height": 96,
    "caption_height": 118,
    "title": "fresh \u00b7 orchestrator",
    "labels": {
      "solo": "NEW"
    },
    "intro_caption": [
      "The Orchestrator dock",
      "a worktree per task, an agent per worktree"
    ],
    "outro_caption": [
      "fresh",
      "github.com/sinelaw/fresh"
    ],
    "timing": {
      "title": 1.6,
      "intro": 0.7,
      "zoom": 0.45,
      "hold": 1.3,
      "pan": 0.3,
      "outro": 0.6
    },
    "theme": {
      "bg": [
        18,
        19,
        26
      ],
      "caption_bg": [
        28,
        29,
        40
      ],
      "panel_border": [
        68,
        71,
        90
      ],
      "muted": [
        150,
        157,
        192
      ],
      "fg": [
        248,
        248,
        242
      ],
      "after": [
        80,
        250,
        123
      ]
    },
    "annotations": [
      {
        "rows": [
          0,
          29
        ],
        "band": false,
        "hold": 1.0,
        "head": "Every worktree is a workspace",
        "sub": "its own tabs, splits, terminals \u2014 and the agent working it",
        "shots": "a"
      },
      {
        "shots": "b",
        "rows": [
          0,
          29
        ],
        "band": false,
        "hold": 2.2,
        "head": "\u2193 walks the dock, and the editor follows",
        "sub": "nothing is torn down: the agent, the split and the tabs were already there"
      },
      {
        "shots": "c",
        "rows": [
          0,
          29
        ],
        "band": false,
        "hold": 1.8,
        "head": "The ones you are not looking at keep working",
        "sub": "quill on one branch, marlin on the next, each in its own worktree"
      },
      {
        "shots": "d",
        "rows": [
          0,
          29
        ],
        "band": false,
        "hold": 2.0,
        "head": "The one that is waiting, with its work open beside it",
        "sub": "three still running \u00b7 this one wants an answer, and its diff is right there"
      },
      {
        "shots": "e",
        "rows": [
          0,
          29
        ],
        "band": false,
        "hold": 2.6,
        "head": "An agent can have the whole workspace",
        "sub": "filmed frame by frame \u2014 this is its own pace, not a speed-up"
      }
    ],
    "title_card": {
      "lines": [
        {
          "text": "mission control",
          "effect": "shine",
          "at": 0.03
        },
        {
          "text": "one editor, every worktree",
          "small": true,
          "at": 0.4
        }
      ]
    },
    "vignette": {
      "edge": 0.012,
      "side": 0.0
    }
  },
  "encode": {
    "crf": 18,
    "preset": "slow"
  }
}