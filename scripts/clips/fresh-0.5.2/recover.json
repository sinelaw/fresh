{
  "name": "fresh-0.5.2-recover",
  "capture": {
    "geometry": "150x34",
    "font": "JetBrains Mono 24",
    "screen": "3200x1700x24",
    "display": ":98",
    "term": "xterm",
    "workdir": "~/repos/fresh/target/clips/fresh-0.5.2-repo",
    "settle": 10,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-0.5.2/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "keys": [
      {
        "sleep": 1
      },
      {
        "shot": "dialog"
      }
    ],
    "panes": {
      "recover": {
        "argv": [
          "sh",
          "-c",
          "$HOME/repos/fresh/scripts/clips/assets/fresh-0.5.2/seed-interrupted-save.sh && exec $HOME/repos/fresh/target/debug/fresh --no-restore --no-upgrade-check src/tides.rs"
        ]
      }
    }
  },
  "render": {
    "rows": 34,
    "cols": 150,
    "annotations": [
      {
        "rows": [
          0,
          34
        ],
        "view": "card",
        "band": false,
        "head": "Interrupted saves, recoverable",
        "shot": "dialog"
      }
    ],
    "views": {
      "card": {
        "rows": [
          8,
          25
        ],
        "cols": [
          36,
          114
        ]
      }
    }
  }
}
