{
  "name": "fresh-0.5.2-settings",
  "capture": {
    "geometry": "150x34",
    "font": "JetBrains Mono 24",
    "screen": "3200x1700x24",
    "display": ":98",
    "term": "xterm",
    "workdir": "~/repos/fresh/target/clips/fresh-0.5.2-repo",
    "settle": 10,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-0.5.2/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "keys": [
      {
        "sleep": 1
      },
      {
        "key": "ctrl+p"
      },
      {
        "type": "Open Settings"
      },
      {
        "key": "Return",
        "settle": 1.2
      },
      {
        "shot": "open"
      },
      {
        "key": "Down",
        "repeat": 6
      },
      {
        "sleep": 0.8
      },
      {
        "shot": "keys"
      }
    ],
    "panes": {
      "settings": {
        "argv": [
          "~/repos/fresh/target/debug/fresh",
          "--no-restore",
          "--no-upgrade-check",
          "src/tides.rs:1:1"
        ]
      }
    }
  },
  "render": {
    "rows": 34,
    "cols": 150,
    "annotations": [
      {
        "rows": [
          0,
          34
        ],
        "view": "tree",
        "band": false,
        "head": "Settings, reorganized",
        "shots": [
          "open",
          "keys"
        ]
      }
    ],
    "views": {
      "tree": {
        "rows": [
          3,
          24
        ],
        "cols": [
          6,
          142
        ]
      }
    }
  }
}
