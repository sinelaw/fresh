{
  "name": "fresh-0.5.2-search",
  "capture": {
    "geometry": "150x34",
    "font": "JetBrains Mono 24",
    "screen": "3200x1700x24",
    "display": ":98",
    "term": "xterm",
    "workdir": "~/repos/fresh/target/clips/fresh-0.5.2-repo",
    "settle": 10,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-0.5.2/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "keys": [
      {
        "sleep": 1
      },
      {
        "key": "ctrl+f"
      },
      {
        "type": "todo"
      },
      {
        "sleep": 0.8
      },
      {
        "shot": "hits"
      }
    ],
    "panes": {
      "search": {
        "argv": [
          "~/repos/fresh/target/debug/fresh",
          "--no-restore",
          "--no-upgrade-check",
          "docs/moorings.md:1:1"
        ]
      }
    }
  },
  "render": {
    "rows": 34,
    "cols": 150,
    "annotations": [
      {
        "rows": [
          7,
          20
        ],
        "view": "hits",
        "band": true,
        "shot": "hits",
        "cols": [
          6,
          12
        ],
        "note": "todo finds TODO, Todo",
        "note_at": "below-right"
      }
    ],
    "views": {
      "hits": {
        "rows": [
          1,
          21
        ],
        "cols": [
          0,
          70
        ]
      }
    }
  }
}
