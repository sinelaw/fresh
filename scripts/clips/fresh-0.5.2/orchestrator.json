{
  "name": "fresh-0.5.2-orchestrator",
  "capture": {
    "geometry": "96x38",
    "font": "JetBrains Mono 16",
    "screen": "1600x1200x24",
    "display": ":98",
    "term": "xterm",
    "workdir": "~/repos/fresh/target/clips/fresh-0.5.2-repo",
    "settle": 14,
    "copy_dirs": {
      "~/repos/fresh/scripts/clips/assets/fresh-0.5.2/fresh": "{scratch}/config/fresh"
    },
    "env": {
      "XDG_CONFIG_HOME": "{scratch}/config",
      "XDG_DATA_HOME": "{scratch}/data-{pane}",
      "XDG_STATE_HOME": "{scratch}/state-{pane}",
      "XDG_RUNTIME_DIR": "{scratch}/run-{pane}"
    },
    "keys": [{"sleep": 1}],
    "panes": {
      "orchestrator": {"argv": ["~/repos/fresh/target/debug/fresh"]}
    }
  },
  "render": {
    "rows": 38, "cols": 96,
    "annotations": [
      {"rows": [0, 38], "cols": [0, 28], "view": "all", "band": false,
       "head": "Orchestrator mode"}
    ],
    "views": {"all": {"rows": [0, 38], "cols": [0, 96]}}
  }
}
