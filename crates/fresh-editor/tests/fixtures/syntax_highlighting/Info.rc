#include <windows.h>

#define APP_VERSION 1,2,3,0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION
 PRODUCTVERSION APP_VERSION
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fresh"
            VALUE "FileDescription", "Fresh Editor"
            VALUE "FileVersion", "1.2.3"
        END
    END
END
