{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh Package Manifest",
  "description": "Schema for Fresh plugin and theme package.json files",
  "type": "object",
  "properties": {
    "name": {
      "description": "Package name (lowercase, hyphens allowed)",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "description": "Semantic version (e.g., 1.0.0)",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "default": null
    },
    "description": {
      "description": "Short package description",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "type": {
      "description": "Package type",
      "anyOf": [
        {
          "$ref": "#/$defs/PackageType"
        },
        {
          "type": "null"
        }
      ]
    },
    "fresh": {
      "description": "Fresh-specific configuration",
      "anyOf": [
        {
          "$ref": "#/$defs/FreshManifestConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "description": "Author name",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "license": {
      "description": "SPDX license identifier",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "repository": {
      "description": "Git repository URL",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "keywords": {
      "description": "Search keywords",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "dependencies": {
      "description": "Package dependencies (reserved for future use)",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    }
  },
  "required": [
    "name"
  ],
  "$defs": {
    "PackageType": {
      "description": "Package type discriminator.",
      "type": "string",
      "enum": [
        "plugin",
        "theme",
        "theme-pack",
        "language",
        "bundle"
      ]
    },
    "FreshManifestConfig": {
      "description": "The `fresh` configuration block inside a package manifest.",
      "type": "object",
      "properties": {
        "min_version": {
          "description": "Minimum required Fresh version",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "min_api_version": {
          "description": "Minimum required plugin API version",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "entry": {
          "description": "Plugin entry point file",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "main": {
          "description": "Plugin entry point file (alias for entry)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "theme": {
          "description": "Single theme JSON file path (for theme packages)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "themes": {
          "description": "Theme definitions (for theme packs and bundles)",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BundleTheme"
          }
        },
        "config_schema": {
          "description": "JSON Schema for plugin configuration options",
          "default": null
        },
        "grammar": {
          "description": "Grammar configuration (for language packs)",
          "anyOf": [
            {
              "$ref": "#/$defs/GrammarManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "description": "Language configuration (for language packs)",
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "lsp": {
          "description": "LSP server configuration (for language packs)",
          "anyOf": [
            {
              "$ref": "#/$defs/LspManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "languages": {
          "description": "Language definitions (for bundles)",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BundleLanguage"
          }
        },
        "plugins": {
          "description": "Plugin definitions (for bundles)",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BundlePlugin"
          }
        }
      }
    },
    "BundleTheme": {
      "description": "A theme entry within a package manifest.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Theme JSON file path relative to package",
          "type": "string"
        },
        "name": {
          "description": "Display name for the theme",
          "type": "string"
        },
        "variant": {
          "description": "Theme variant (dark or light)",
          "anyOf": [
            {
              "$ref": "#/$defs/ThemeVariant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "file",
        "name"
      ]
    },
    "ThemeVariant": {
      "description": "Theme variant (dark or light).",
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "GrammarManifestConfig": {
      "description": "Grammar file configuration within a package manifest.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Path to grammar file (.sublime-syntax or .tmLanguage), relative to package",
          "type": "string"
        },
        "extensions": {
          "description": "File extensions this grammar handles (e.g., [\"rs\", \"rust\"])",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "firstLine": {
          "description": "Regex pattern for shebang/first-line detection",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "shortName": {
          "description": "Optional short name alias for this grammar (e.g., \"hare\").\nMust be unique across all grammars; collisions are rejected with a warning.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "file"
      ]
    },
    "LanguageManifestConfig": {
      "description": "Language configuration within a package manifest (camelCase to match JSON schema).",
      "type": "object",
      "properties": {
        "commentPrefix": {
          "description": "Line comment prefix (e.g., \"//\" or \"#\")",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "blockCommentStart": {
          "description": "Block comment start marker (e.g., \"/*\")",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "blockCommentEnd": {
          "description": "Block comment end marker (e.g., \"*/\")",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tabSize": {
          "description": "Default tab size for this language",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "useTabs": {
          "description": "Use tabs instead of spaces",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "autoIndent": {
          "description": "Enable automatic indentation",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "showWhitespaceTabs": {
          "description": "Whether to show whitespace tab indicators",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "formatter": {
          "description": "Formatter configuration",
          "anyOf": [
            {
              "$ref": "#/$defs/FormatterManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "editRules": {
          "description": "Edit rules for Enter / Tab / Shift+Tab: the language's `edit_rules`\nsetting, in the same format. A rule that doesn't compile is skipped\nwith a warning.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EditRule"
          },
          "default": []
        }
      }
    },
    "FormatterManifestConfig": {
      "description": "Formatter configuration within a package manifest.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Formatter command (e.g., \"rustfmt\", \"prettier\")",
          "type": "string"
        },
        "args": {
          "description": "Arguments to pass to the formatter",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "command"
      ]
    },
    "EditRule": {
      "description": "One rule: when its key is pressed and the cursor's line matches, the\nline is rewritten from templates instead of the key's normal edit.\n\nThe same format serves a language's `edit_rules` setting\n(`languages.<id>.edit_rules` in config.json), a language pack's\n`editRules`, and `registerEditRules`.\n\nThe line is split at the cursor into the text **before** it (from the\nline start) and the text **after** it (to the line end, without the line\nbreak). `before` and `after` are regular expressions searched in those\ntwo parts (Rust `regex` syntax: no look-around or back-references; use\n`^` and `$` to anchor). Both must match for the rule to apply; one left\nout matches anything. The result is\n\n```text\n(replaceBefore ?? before) + (insert ?? \"\") + CURSOR + (replaceAfter ?? after)\n```\n\nso `insert` adds text at the cursor and the `replace*` templates rewrite\neither part. At least one of the three must be given.\n\nTemplates are literal text with these substitutions:\n\n- `$0`…`$9`, `${12}`: a capture group of `before` (`$0` is its whole\n  match); `${name}`: a named group of `before` or else of `after`. A\n  group that did not take part in the match is empty.\n- `${inc:REF}`: the capture (a `REF` as above, e.g. `${inc:2}`) as a\n  decimal number plus one, keeping zero-padding (`09` → `10`, `007` → `008`).\n- `${cycle:REF:a|b|c}`: the value after the capture's value in the\n  list, wrapping around (`b` → `c`, `c` → `a`). List the values in the\n  reverse order to step backwards.\n- `${indent}`: one indentation level of the buffer — a tab, or\n  `tab_size` spaces, per its `use_tabs` / `tab_size` settings.\n- `${dedent:REF}`: the capture with one indentation level taken off its\n  start: a leading tab, or `tab_size` leading spaces.\n- `$$`: a literal `$`. A line break in a template is written as the\n  buffer's line ending (`\\n` or `\\r\\n`).\n\nWhen `${inc}`, `${cycle}` or `${dedent}` has nothing to work with (not a\nnumber, a value not in the list, less than a level of indentation), the\nrule does not apply and the next one is tried.",
      "type": "object",
      "properties": {
        "on": {
          "description": "The key this rule answers.",
          "$ref": "#/$defs/EditRuleTrigger"
        },
        "before": {
          "description": "Pattern searched in the line's text before the cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "description": "Pattern searched in the line's text after the cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "insert": {
          "description": "Template inserted at the cursor; the cursor ends up after it.",
          "type": [
            "string",
            "null"
          ]
        },
        "replaceBefore": {
          "description": "Template that replaces the line's text before the cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "replaceAfter": {
          "description": "Template that replaces the line's text after the cursor.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "on"
      ],
      "x-display-field": "/before"
    },
    "EditRuleTrigger": {
      "description": "The key a rule answers: Enter (`newline`), Tab (`indent`) or Shift+Tab (`dedent`).",
      "type": "string",
      "enum": [
        "newline",
        "indent",
        "dedent"
      ]
    },
    "LspManifestConfig": {
      "description": "LSP server configuration within a package manifest (camelCase to match JSON schema).",
      "type": "object",
      "properties": {
        "command": {
          "description": "LSP server command",
          "type": "string"
        },
        "args": {
          "description": "Arguments to pass to the server",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "autoStart": {
          "description": "Auto-start the server when a matching file is opened",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "initializationOptions": {
          "description": "LSP initialization options",
          "default": null
        },
        "processLimits": {
          "description": "Process resource limits",
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessLimitsManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "command"
      ]
    },
    "ProcessLimitsManifestConfig": {
      "description": "Process limits within a package manifest (camelCase to match JSON schema).",
      "type": "object",
      "properties": {
        "maxMemoryPercent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "maxCpuPercent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "default": null
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        }
      }
    },
    "BundleLanguage": {
      "description": "A language entry within a bundle manifest.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Language identifier (e.g., \"elixir\", \"heex\")",
          "type": "string"
        },
        "grammar": {
          "description": "Grammar configuration for this language",
          "anyOf": [
            {
              "$ref": "#/$defs/GrammarManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "description": "Language configuration for this language",
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "lsp": {
          "description": "LSP server configuration for this language",
          "anyOf": [
            {
              "$ref": "#/$defs/LspManifestConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "BundlePlugin": {
      "description": "A plugin entry within a bundle manifest.",
      "type": "object",
      "properties": {
        "entry": {
          "description": "Plugin entry point file relative to package",
          "type": "string"
        }
      },
      "required": [
        "entry"
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/sinelaw/fresh/main/crates/fresh-editor/plugins/schemas/package.schema.json"
}
